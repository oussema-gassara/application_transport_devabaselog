  usecase "Consulter départs et places" as UC5
  usecase "Choisir véhicule et siège" as UC6
  usecase "Réserver un siège" as UC7
  usecase "Payer en ligne" as UC8
  usecase "Payer en espèces à l'embarquement" as UC9
  usecase "Consulter billet QR" as UC10
  usecase "Modifier / annuler réservation" as UC11
  usecase "Consulter historique" as UC12
  usecase "Suivre véhicule et ETA" as UC13
  usecase "Choisir siège adapté" as UC14
  usecase "Réduction de 6 % après validation PMR" as UC15
}
Client -- UC1
Client -- UC2
Client -- UC3
Client -- UC4
Client -- UC5
Client -- UC6
Client -- UC7
Client -- UC8
Client -- UC9
Client -- UC10
